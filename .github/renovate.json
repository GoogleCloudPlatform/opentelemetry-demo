{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["helmfile"],
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": ["helm/helm", "helmfile/helmfile"],
      "groupName": "helm-tools"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm-dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go-dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/regenerate-manifests\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+[A-Z_]+_VERSION=\"(?<currentValue>.*?)\""
      ]
    }
  ]
}
